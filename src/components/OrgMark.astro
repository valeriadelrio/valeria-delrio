---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AbstractMark from './AbstractMark.astro';

interface Props {
	name: string;
	logo?: ImageMetadata;
}

const { name, logo } = Astro.props;
const size = 44;
---

<div class="org-mark">
	{
		logo ? (
			// Decorative: the company name is already in the heading next to it.
			<Image src={logo} alt="" width={size} height={size} densities={[1, 2]} loading="lazy" />
		) : (
			<AbstractMark name={name} size={size} />
		)
	}
</div>

---
// Decorative stand-in for a missing logo: a small abstract composition
// derived from the name, so each company always gets the same image.

interface Props {
	name: string;
	size?: number;
}

const { name, size = 44 } = Astro.props;

// FNV-1a: tiny, stable string hash.
let hash = 2166136261;
for (const ch of name) {
	hash ^= ch.codePointAt(0)!;
	hash = Math.imul(hash, 16777619) >>> 0;
}
const pick = <T,>(list: readonly T[], shift: number) => list[(hash >>> shift) % list.length];

// Pairs tuned to sit next to the site's teal accent.
const palettes = [
	['#1f5f5b', '#7cc4bc', '#f2c38b'],
	['#2d4a6b', '#8fb3d9', '#f0a68c'],
	['#4b3b6b', '#b4a3d9', '#9fd6c9'],
	['#6b4b2d', '#e0b48a', '#8fc0b8'],
	['#2e5a3f', '#9fd0a8', '#e8c27a'],
] as const;
const [base, mid, pop] = pick(palettes, 0);

const corner = pick([0, 1, 2, 3], 4);
const [cx, cy] = [
	[0, 0],
	[100, 0],
	[100, 100],
	[0, 100],
][corner];
const [ox, oy] = [100 - cx, 100 - cy];
const dotR = 10 + ((hash >>> 8) % 8);
const id = `am-${hash.toString(36)}`;
---

<svg
	class="abstract-mark"
	width={size}
	height={size}
	viewBox="0 0 100 100"
	role="img"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<clipPath id={id}><rect width="100" height="100" rx="18" /></clipPath>
	</defs>
	<g clip-path={`url(#${id})`}>
		<rect width="100" height="100" fill={base} />
		<circle cx={cx} cy={cy} r="78" fill={mid} opacity="0.55" />
		<circle cx={cx} cy={cy} r="46" fill={mid} />
		<circle cx={ox * 0.7 + cx * 0.3} cy={oy * 0.7 + cy * 0.3} r={dotR} fill={pop} />
	</g>
</svg>
